{
  "name": "@sky9464/weixin-bot",
  "version": "0.0.5",
  "description": "WeChat iLink Bot SDK for typescript, compatible with Cloudflare Workers and Node.js",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
