  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "undici-types": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
